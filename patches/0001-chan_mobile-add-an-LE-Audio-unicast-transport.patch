+static int mbl_cvsd_decode(struct mbl_pvt *pvt, const uint8_t *input,
+	size_t input_length, int16_t *output, size_t output_capacity)
+{
+	size_t input_offset = 0;
+	size_t output_samples = 0;
+
+	while (input_offset < input_length) {
+		uint8_t bytes[2];
+		int16_t sample;
+
+		if (pvt->cvsd_carry_valid) {
+			bytes[0] = pvt->cvsd_carry;
+			bytes[1] = input[input_offset++];
+			pvt->cvsd_carry_valid = 0;
+		} else if (input_offset + 1 < input_length) {
+			bytes[0] = input[input_offset++];
+			bytes[1] = input[input_offset++];
+		} else {
+			pvt->cvsd_carry = input[input_offset];
+			pvt->cvsd_carry_valid = 1;
+			break;
+		}
+
+		memcpy(&sample, bytes, sizeof(sample));
+		if (pvt->wideband_capable) {
+			if (output_samples + 2 > output_capacity)
+				return -ENOSPC;
+			output[output_samples++] = sample;
+			output[output_samples++] = sample;
+		} else {
+			if (output_samples + 1 > output_capacity)
+				return -ENOSPC;
+			output[output_samples++] = sample;
+		}
+	}
+
+	return (int) output_samples;
+}
