+		pvt->audio_codec == MBL_AUDIO_MSBC) {
+		if (options_read)
+			ast_log(LOG_NOTICE,
+				"[%s] SCO MTU kernel=%u selected=%u MediaTek=%s\n",
+				pvt->id, kernel_mtu, mtu,
+				pvt->adapter->mediatek ? "yes" : "no");
+		else
+			ast_log(LOG_NOTICE,
+				"[%s] SCO MTU kernel=unavailable selected=%u MediaTek=%s "
+				"controller=%u errno=%d\n",
