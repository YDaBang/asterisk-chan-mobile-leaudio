+static void mbl_stats_add(uint64_t *value, uint64_t increment)
+{
+	if (UINT64_MAX - *value < increment)
+		*value = UINT64_MAX;
+	else
+		*value += increment;
+}
+
+static void mbl_stats_inc(uint64_t *value)
+{
+	mbl_stats_add(value, 1);
+}
+
+static const char *mbl_msbc_stats_reason_name(enum mbl_msbc_stats_reason reason)
+{
+	switch (reason) {
+	case MBL_MSBC_STATS_HANGUP:
+		return "hangup";
+	case MBL_MSBC_STATS_RFCOMM_DISCONNECT:
+		return "rfcomm-disconnect";
+	case MBL_MSBC_STATS_SUPERSEDED:
+		return "superseded";
+	}
+	return "unknown";
+}
+
+/*
+ * The caller holds pvt->lock. Emit one fixed-schema summary containing only
+ * aggregate counters. In particular, do not add channel, call, phone,
+ * Bluetooth, SIP, or audio identifiers to this line.
+ */
+static void mbl_msbc_stats_report_locked(struct mbl_pvt *pvt,
+	enum mbl_msbc_stats_reason reason)
+{
+	struct mbl_msbc_call_stats *stats = &pvt->msbc_stats;
+
+	if (!stats->active)
+		return;
+
+	cm_msbc_set_rx_stats(&pvt->msbc, NULL);
+	if (!stats->used_msbc) {
+		memset(stats, 0, sizeof(*stats));
+		return;
+	}
+	ast_log(LOG_NOTICE,
+		"MSBC_CALL_STATS v=1 reason=%s "
+		"rx_feed_bytes=%" PRIu64 " rx_good=%" PRIu64 " "
+		"rx_gap_events=%" PRIu64 " rx_gap_frames=%" PRIu64 " "
+		"rx_decode_fail=%" PRIu64 " rx_resync=%" PRIu64 " "
+		"rx_discard_bytes=%" PRIu64 " rx_concealed=%" PRIu64 " "
+		"plc_substitution=%" PRIu64 " plc_zir=%" PRIu64 " "
+		"plc_decoder_reinit=%" PRIu64 " "
+		"plc_zero_decode_fail=%" PRIu64 " "
+		"rx_enobufs=%" PRIu64 " rx_enospc=%" PRIu64 " "
+		"tx_pcm_frames=%" PRIu64 " tx_encoded_frames=%" PRIu64 " "
+		"tx_encode_fail=%" PRIu64 " "
+		"tx_packetizer_enobufs=%" PRIu64 " "
+		"tx_packetizer_invalid=%" PRIu64 " "
+		"tx_smoother_fail=%" PRIu64 " sco_links=%" PRIu64 " "
+		"sco_rx_bytes=%" PRIu64 " sco_read_fail=%" PRIu64 " "
+		"sco_tx_packets=%" PRIu64 " sco_tx_bytes=%" PRIu64 " "
+		"sco_tx_fail=%" PRIu64 " preanswer_drop=%" PRIu64 "\n",
+		mbl_msbc_stats_reason_name(reason),
+		stats->rx.feed_bytes, stats->rx.good_frames,
+		stats->rx.seq_gap_events, stats->rx.seq_gap_frames,
+		stats->rx.decode_failures, stats->rx.h2_resync_events,
+		stats->rx.h2_discarded_bytes, stats->rx.concealed_frames,
+		stats->rx.plc_substitution_frames, stats->rx.plc_zir_frames,
+		stats->rx.plc_decoder_reinits,
+		stats->rx.plc_zero_decode_failures,
+		stats->rx.enobufs, stats->rx.enospc,
+		stats->tx_pcm_frames, stats->tx_encoded_frames,
+		stats->tx_encode_failures, stats->tx_packetizer_enobufs,
+		stats->tx_packetizer_invalid, stats->tx_smoother_failures,
+		stats->sco_links, stats->sco_rx_bytes,
+		stats->sco_read_failures, stats->sco_tx_packets,
+		stats->sco_tx_bytes, stats->sco_write_failures,
+		stats->preanswer_sco_drops);
+	memset(stats, 0, sizeof(*stats));
+}
+
+/* The caller holds pvt->lock and has just created a voice channel. */
+static void mbl_msbc_stats_begin_locked(struct mbl_pvt *pvt)
+{
+	struct mbl_msbc_call_stats *stats = &pvt->msbc_stats;
+
+	if (stats->active)
+		mbl_msbc_stats_report_locked(pvt, MBL_MSBC_STATS_SUPERSEDED);
+	if (pvt->type != MBL_TYPE_PHONE ||
+		(!pvt->wideband_requested && !pvt->wideband_capable))
+		return;
+
+	memset(stats, 0, sizeof(*stats));
+	stats->active = 1;
+	cm_msbc_set_rx_stats(&pvt->msbc, NULL);
+	if (pvt->audio_codec == MBL_AUDIO_MSBC && pvt->sco_socket != -1) {
+		stats->used_msbc = 1;
+		stats->sco_links = 1;
+		cm_msbc_set_rx_stats(&pvt->msbc, &stats->rx);
+	}
+}
+
+static struct ast_format *mbl_leaudio_format(unsigned int sample_rate)
+{
+	switch (sample_rate) {
+	case 16000:
+		return ast_format_slin16;
+	case 24000:
+		return ast_format_slin24;
+	case 32000:
+		return ast_format_slin32;
+	default:
+		return NULL;
+	}
+}
+
+/* The caller holds pvt->lock. The channel pointer and media generations form
+ * one immutable I/O capability. A later channel may reuse the same numeric fd,
+ * but an older callback cannot pass both parts of this check. */
+static void mbl_leaudio_session_clear_locked(struct mbl_pvt *pvt)
+{
+	memset(&pvt->leaudio_session, 0, sizeof(pvt->leaudio_session));
+	pvt->leaudio_session_owner = NULL;
+	pvt->leaudio_session_valid = 0;
+}
+
+static int mbl_leaudio_session_capture_locked(struct mbl_pvt *pvt,
+	struct ast_channel *owner)
+{
+	struct cm_leaudio_session_id session;
+
+	if (!pvt || !owner || owner != pvt->owner ||
+		cm_leaudio_get_session_id(&pvt->leaudio, &session) < 0) {
+		if (pvt)
+			mbl_leaudio_session_clear_locked(pvt);
+		return -ESTALE;
+	}
+	pvt->leaudio_session = session;
+	pvt->leaudio_session_owner = owner;
+	pvt->leaudio_session_valid = 1;
+	return 0;
+}
+
+static void mbl_leaudio_end_locked(struct mbl_pvt *pvt)
+{
+	mbl_leaudio_session_clear_locked(pvt);
+	cm_leaudio_end(&pvt->leaudio);
+}
+
+/* The caller holds pvt->lock. The report is emitted once per activated media
+ * pair and contains only aggregate I/O state, never audio or identifiers from
+ * the call signaling payload. */
+static void mbl_leaudio_stats_report_locked(struct mbl_pvt *pvt,
+	const char *reason)
+{
+	const struct cm_leaudio_io_stats *stats;
+
+	if (pvt->leaudio_stats_reported)
+		return;
+	stats = cm_leaudio_get_io_stats(&pvt->leaudio);
+	if (!stats)
+		return;
+	if (!pvt->leaudio.active && stats->read_calls == 0 &&
+		stats->write_calls == 0)
+		return;
+	ast_log(LOG_NOTICE,
+		"[%s] LE_AUDIO_IO_STATS reason=%s "
