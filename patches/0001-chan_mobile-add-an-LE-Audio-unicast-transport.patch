+static int mbl_msbc_write_frame(struct mbl_pvt *pvt, const int16_t *pcm)
+{
+	uint8_t encoded[CM_MSBC_FRAME_BYTES];
+	uint8_t packets[CM_MSBC_MAX_SCO_MTU];
+	unsigned int mtu = pvt->sco_mtu;
+	size_t packets_length;
+	size_t offset;
+	int result;
+
+	if (pvt->msbc_stats.active)
+		mbl_stats_inc(&pvt->msbc_stats.tx_pcm_frames);
+	result = cm_msbc_encode(&pvt->msbc, pcm, encoded);
+	if (result < 0) {
+		if (pvt->msbc_stats.active)
+			mbl_stats_inc(&pvt->msbc_stats.tx_encode_failures);
+		ast_log(LOG_WARNING, "[%s] mSBC encode failed: %d\n", pvt->id, result);
+		return MBL_AUDIO_WRITE_FATAL;
+	}
+	if (pvt->msbc_stats.active)
+		mbl_stats_inc(&pvt->msbc_stats.tx_encoded_frames);
+	if (mtu == 0 || mtu > CM_MSBC_MAX_SCO_MTU)
+		mtu = 24;
+	result = cm_msbc_tx_packetize(&pvt->msbc_tx, encoded, mtu, packets,
+		&packets_length);
+	if (result < 0) {
+		if (pvt->msbc_stats.active) {
+			if (result == -ENOBUFS)
+				mbl_stats_inc(
+					&pvt->msbc_stats.tx_packetizer_enobufs);
+			else
+				mbl_stats_inc(
+					&pvt->msbc_stats.tx_packetizer_invalid);
+		}
+		ast_log(LOG_WARNING, "[%s] mSBC packetizer failed: %d\n",
+			pvt->id, result);
+		cm_msbc_tx_packetizer_reset(&pvt->msbc_tx);
+		return MBL_AUDIO_WRITE_FATAL;
+	}
+
+	for (offset = 0; offset < packets_length; offset += mtu) {
+		if (!sco_write(pvt->sco_socket, (char *) packets + offset, mtu)) {
+			if (pvt->msbc_stats.active)
+				mbl_stats_inc(&pvt->msbc_stats.sco_write_failures);
+			return offset == 0 ?
+				MBL_AUDIO_WRITE_SCO_FAILURE :
+				MBL_AUDIO_WRITE_FATAL;
+		}
+		if (pvt->msbc_stats.active) {
+			mbl_stats_inc(&pvt->msbc_stats.sco_tx_packets);
+			mbl_stats_add(&pvt->msbc_stats.sco_tx_bytes, mtu);
+		}
+	}
+	return MBL_AUDIO_WRITE_OK;
+}
