+/* The caller holds pvt->lock. A terminal media error ends the complete linked
+ * CIS session. Keeping only one direction alive leaves the Go D-Bus owner and
+ * BlueZ MediaTransport active, which prevents the next call from acquiring. */
+static void mbl_leaudio_fail_locked(struct mbl_pvt *pvt,
+	const char *direction, const char *stage, int result, int detail,
+	int64_t sdu_length)
+{
+	unsigned int rx_active;
+	unsigned int tx_active;
+
+	if (pvt->call_audio_transport != MBL_CALL_AUDIO_LE)
+		return;
+	rx_active = (unsigned int) cm_leaudio_rx_active(&pvt->leaudio);
+	tx_active = (unsigned int) cm_leaudio_tx_active(&pvt->leaudio);
+	if (pvt->owner)
+		ast_channel_set_fd(pvt->owner, 0, -1);
+	ast_log(LOG_WARNING,
+		"[%s] LE_AUDIO_IO_ERROR direction=%s stage=%s result=%d detail=%d sdu_length=%" PRId64 " rx_active=%u tx_active=%u action=bilateral-teardown\n",
+		pvt->id, direction ? direction : "unknown",
+		stage ? stage : "unknown", result, detail, sdu_length,
+		rx_active, tx_active);
+	mbl_leaudio_stats_report_locked(pvt, "terminal-media-error");
+	mbl_leaudio_end_locked(pvt);
+	pvt->call_audio_transport = MBL_CALL_AUDIO_LE_FAILED;
+	if (pvt->owner)
+		mbl_queue_hangup(pvt);
+}
+
+static void mbl_leaudio_rx_fail_locked(struct mbl_pvt *pvt,
+	const char *stage, int result, int detail, int64_t sdu_length)
+{
+	mbl_leaudio_fail_locked(pvt, "rx", stage, result, detail, sdu_length);
+}
+
+static void mbl_leaudio_tx_fail_locked(struct mbl_pvt *pvt,
+	const char *stage, int result, int detail)
+{
+	mbl_leaudio_fail_locked(pvt, "tx", stage, result, detail, -1);
+}
+
+static int mbl_lecall_available(const struct mbl_pvt *pvt)
+{
+	if (!pvt)
+		return 0;
+	return pvt->call_control == MBL_CALL_CONTROL_LE_GTBS ?
+		pvt->lecall_ready : pvt->connected;
+}
+
+/* The caller holds pvt->lock. */
+static int mbl_lecall_send_locked(struct mbl_pvt *pvt, uint8_t opcode,
+	const uint8_t *payload, size_t payload_length)
+{
+	struct cm_le_call_message message;
+	char address[18];
+	int result;
+
+	if (!pvt || pvt->call_control != MBL_CALL_CONTROL_LE_GTBS ||
+		!pvt->lecall_ready)
+		return -ENOTCONN;
+	memset(&message, 0, sizeof(message));
+	message.type = CM_LE_CALL_COMMAND;
+	message.code = opcode;
+	ba2str(&pvt->addr, address);
+	ast_copy_string(message.device, address, sizeof(message.device));
+	if (opcode == CM_LE_CALL_ORIGINATE) {
+		if (!payload || payload_length > sizeof(message.payload))
+			return -EINVAL;
+		message.payload_length = (uint16_t) payload_length;
+		memcpy(message.payload, payload, payload_length);
+	} else {
+		if (payload_length != 0 || pvt->lecall_index == 0 ||
+			pvt->lecall_token == 0)
+			return -ESTALE;
+		message.index = pvt->lecall_index;
+		message.token = pvt->lecall_token;
+	}
+
+	ast_mutex_lock(&lecall_socket_mutex);
+	if (lecall_socket < 0) {
+		result = -ENOTCONN;
+	} else {
+		if (++lecall_command_sequence == 0)
+			++lecall_command_sequence;
+		message.sequence = lecall_command_sequence;
+		result = cm_le_call_send(lecall_socket, &message);
+	}
+	ast_mutex_unlock(&lecall_socket_mutex);
+	if (result == 0) {
+		pvt->lecall_pending_sequence = message.sequence;
+		pvt->lecall_pending_opcode = opcode;
+	}
+	return result;
+}
+
+/* The caller holds pvt->lock and the owner channel lock. Media activation
+ * never changes call state. */
+static int mbl_leaudio_activate_channel_locked(struct mbl_pvt *pvt)
+{
+	struct ast_format_cap *native_cap = NULL;
+	struct ast_format *raw_format;
+	struct ast_dsp *new_dsp = NULL;
+	int samples;
+	int result = -EINVAL;
+
+	if (!pvt->owner || pvt->call_control != MBL_CALL_CONTROL_LE_GTBS ||
+		pvt->lecall_token == 0 || !cm_leaudio_ready(&pvt->leaudio))
+		return -EAGAIN;
+	if (!pvt->leaudio.sink.call_control_correlated ||
+		pvt->leaudio.sink.call_control_token != pvt->lecall_token ||
+		pvt->leaudio.source.call_control_token != pvt->lecall_token)
+		return -ESTALE;
+	if (cm_leaudio_begin(&pvt->leaudio) < 0)
+		return -EINVAL;
+	raw_format = mbl_leaudio_format(
+		(unsigned int) cm_leaudio_sample_rate(&pvt->leaudio));
+	samples = cm_leaudio_frame_samples(&pvt->leaudio);
+	if (!raw_format || samples <= 0)
+		goto fail;
+	new_dsp = ast_dsp_new_with_rate(
+		(unsigned int) cm_leaudio_sample_rate(&pvt->leaudio));
+	if (!new_dsp)
+		goto fail;
+	ast_dsp_set_features(new_dsp, DSP_FEATURE_DIGIT_DETECT);
+	ast_dsp_set_digitmode(new_dsp,
+		DSP_DIGITMODE_DTMF | DSP_DIGITMODE_RELAXDTMF);
+	native_cap = ast_format_cap_alloc(AST_FORMAT_CAP_FLAG_DEFAULT);
+	if (!native_cap || ast_format_cap_append(native_cap, raw_format, 0))
+		goto fail;
+	if (ast_set_read_format_path(pvt->owner, raw_format,
+		ast_channel_readformat(pvt->owner)) ||
+		ast_set_write_format_path(pvt->owner,
+			ast_channel_writeformat(pvt->owner), raw_format))
+		goto fail;
+	ast_channel_nativeformats_set(pvt->owner, native_cap);
+	ast_dsp_free(pvt->dsp);
+	pvt->dsp = new_dsp;
+	new_dsp = NULL;
+	ast_smoother_reset(pvt->bt_out_smoother,
+		samples * (int) sizeof(int16_t));
+	ast_smoother_reset(pvt->bt_in_smoother,
+		samples * (int) sizeof(int16_t));
+	ast_dsp_digitreset(pvt->dsp);
+	pvt->call_audio_transport = MBL_CALL_AUDIO_LE;
+	pvt->leaudio_stats_reported = 0;
+	if (mbl_leaudio_session_capture_locked(pvt, pvt->owner) < 0)
+		goto fail;
+	ast_channel_set_fd(pvt->owner, 0,
+		cm_leaudio_read_fd(&pvt->leaudio));
+	if (ast_channel_is_bridged(pvt->owner))
+		ast_channel_set_unbridged_nolock(pvt->owner, 1);
+	ast_log(LOG_NOTICE,
+		"[%s] correlated LE Audio activated rate=%d frame-us=%d token=%" PRIu64 "\n",
+		pvt->id, cm_leaudio_sample_rate(&pvt->leaudio),
+		cm_leaudio_frame_duration_us(&pvt->leaudio),
+		pvt->lecall_token);
+	result = 0;
+
+fail:
+	ao2_cleanup(native_cap);
+	if (new_dsp)
+		ast_dsp_free(new_dsp);
+	if (result != 0) {
+		mbl_leaudio_end_locked(pvt);
+		pvt->call_audio_transport = MBL_CALL_AUDIO_LE_FAILED;
+	}
+	return result;
+}
+
+/* The caller holds pvt->lock. Follow chan_mobile's established lock-order
+ * avoidance when an asynchronous GTBS or ISO event changes channel media. */
+static int mbl_leaudio_activate_locked(struct mbl_pvt *pvt)
+{
+	for (;;) {
+		struct ast_channel *owner = pvt->owner;
+		int result;
+
+		if (!owner)
+			return -EAGAIN;
+		if (ast_channel_trylock(owner)) {
+			DEADLOCK_AVOIDANCE(&pvt->lock);
+			continue;
+		}
+		if (owner != pvt->owner) {
+			ast_channel_unlock(owner);
+			continue;
+		}
+		result = mbl_leaudio_activate_channel_locked(pvt);
+		ast_channel_unlock(owner);
+		return result;
+	}
+}
+
+/* The caller holds pvt->lock and does not hold the owner channel lock. */
+static void mbl_leaudio_stop_locked(struct mbl_pvt *pvt,
+	enum mbl_call_audio_transport next_transport)
+{
+	for (;;) {
+		struct ast_channel *owner = pvt->owner;
+
+		if (!owner) {
+			mbl_leaudio_stats_report_locked(pvt, "transport-stop");
+			mbl_leaudio_end_locked(pvt);
+			pvt->call_audio_transport = next_transport;
+			return;
+		}
+		if (ast_channel_trylock(owner)) {
+			DEADLOCK_AVOIDANCE(&pvt->lock);
+			continue;
+		}
+		if (owner != pvt->owner) {
+			ast_channel_unlock(owner);
+			continue;
+		}
+		ast_channel_set_fd(owner, 0, -1);
+		mbl_leaudio_stats_report_locked(pvt, "transport-stop");
+		mbl_leaudio_end_locked(pvt);
+		pvt->call_audio_transport = next_transport;
+		ast_channel_unlock(owner);
+		return;
+	}
+}
