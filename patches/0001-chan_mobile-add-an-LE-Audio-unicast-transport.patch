+static void mbl_leaudio_dispatch(struct cm_le_descriptor *descriptor,
+	int media_fd, int lifecycle_fd)
+{
+	struct mbl_pvt *pvt;
+	int matched = 0;
+
+	AST_RWLIST_RDLOCK(&devices);
+	AST_RWLIST_TRAVERSE(&devices, pvt, entry) {
+		char address[18];
+		int result;
+		int installed = 0;
+
+		if (pvt->audio_transport != MBL_AUDIO_TRANSPORT_LE_CANARY)
+			continue;
+		ba2str(&pvt->addr, address);
+		if (!cm_le_descriptor_matches_address(descriptor, address))
+			continue;
+		matched = 1;
+		ast_mutex_lock(&pvt->lock);
+		if (pvt->call_control == MBL_CALL_CONTROL_LE_GTBS &&
+			(!descriptor->call_control_correlated ||
+			 (pvt->lecall_token != 0 &&
+			  descriptor->call_control_token != pvt->lecall_token))) {
+			result = -ESTALE;
+		} else if (pvt->owner &&
+			pvt->call_control != MBL_CALL_CONTROL_LE_GTBS) {
+			result = -EBUSY;
+		} else {
+			result = cm_leaudio_install_with_lifecycle(&pvt->leaudio,
+				descriptor, media_fd, lifecycle_fd);
+			if (result == 0) {
+				installed = 1;
+				media_fd = -1;
+				lifecycle_fd = -1;
+				if (pvt->owner && pvt->lecall_token != 0 &&
+					cm_leaudio_ready(&pvt->leaudio))
+					result = mbl_leaudio_activate_locked(pvt);
+			}
+		}
+		ast_mutex_unlock(&pvt->lock);
+		if (installed) {
+			ast_log(LOG_NOTICE,
+				"[%s] staged LE Audio direction=%u rate=%u frame-us=%u generation=%" PRIu64 " bundle=%" PRIu64 " cig=%u cis=%u call-correlated=%u\n",
+				pvt->id, (unsigned int) descriptor->direction,
+				descriptor->sample_rate, descriptor->frame_duration_us,
+				descriptor->generation, descriptor->bundle_id,
+				(unsigned int) descriptor->cig,
+				(unsigned int) descriptor->cis,
+				(unsigned int) descriptor->call_control_correlated);
+			if (result < 0)
+				ast_log(LOG_WARNING,
+					"[%s] correlated LE Audio activation failed without changing call state: %s\n",
+					pvt->id, strerror(-result));
+		} else {
+			ast_log(LOG_WARNING,
+				"[%s] discarded LE Audio media descriptor without changing call state: %s\n",
+				pvt->id, strerror(-result));
+		}
+		break;
+	}
+	AST_RWLIST_UNLOCK(&devices);
+	if (!matched)
+		ast_log(LOG_WARNING,
+			"discarded LE Audio descriptor for an unconfigured device\n");
+	if (media_fd >= 0)
+		close(media_fd);
+	if (lifecycle_fd >= 0)
+		close(lifecycle_fd);
+}
+
+static void mbl_leaudio_reset_staged_all(void)
+{
+	struct mbl_pvt *pvt;
+
+	AST_RWLIST_RDLOCK(&devices);
+	AST_RWLIST_TRAVERSE(&devices, pvt, entry) {
+		if (pvt->audio_transport != MBL_AUDIO_TRANSPORT_LE_CANARY)
+			continue;
+		ast_mutex_lock(&pvt->lock);
+		cm_leaudio_reset_staged(&pvt->leaudio);
+		ast_mutex_unlock(&pvt->lock);
+	}
+	AST_RWLIST_UNLOCK(&devices);
+}
+
+static void mbl_leaudio_disconnect(int *handoff_fd)
+{
+	if (!handoff_fd || *handoff_fd < 0)
+		return;
+	close(*handoff_fd);
+	*handoff_fd = -1;
+	/* A successfully started call owns both media descriptors independently.
+	 * Only an incomplete, not-yet-active pair is discarded here. */
+	mbl_leaudio_reset_staged_all();
+}
+
+static void *do_leaudio_handoff(void *data)
+{
+	int handoff_fd = -1;
+
+	(void) data;
+	while (!check_unloading()) {
+		struct pollfd wait_fd;
+		int ready;
+
+		if (handoff_fd < 0) {
+			handoff_fd = cm_le_handoff_connect(leaudio_socket_path);
+			if (handoff_fd < 0) {
+				sleep(1);
+				continue;
+			}
+			ast_log(LOG_NOTICE,
+				"LE Audio handoff connected policy=le-canary\n");
+		}
+		memset(&wait_fd, 0, sizeof(wait_fd));
+		wait_fd.fd = handoff_fd;
+		wait_fd.events = POLLIN;
+		ready = poll(&wait_fd, 1, 1000);
+		if (ready < 0) {
+			if (errno == EINTR)
+				continue;
+			mbl_leaudio_disconnect(&handoff_fd);
+			continue;
+		}
+		if (ready == 0)
+			continue;
+		if (wait_fd.revents & POLLIN) {
+			for (;;) {
+				struct cm_le_descriptor descriptor;
+				int media_fd = -1;
+				int lifecycle_fd = -1;
+				int result = cm_le_handoff_receive(handoff_fd,
+					&descriptor, &media_fd, &lifecycle_fd);
+
+				if (result == -EAGAIN || result == -EWOULDBLOCK)
+					break;
+				if (result < 0) {
+					mbl_leaudio_disconnect(&handoff_fd);
+					break;
+				}
+				mbl_leaudio_dispatch(&descriptor, media_fd, lifecycle_fd);
+			}
+		}
+		if (handoff_fd >= 0 &&
+			(wait_fd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+			mbl_leaudio_disconnect(&handoff_fd);
+		}
+	}
+	mbl_leaudio_disconnect(&handoff_fd);
+	return NULL;
+}
+
+static void mbl_lecall_reset_build_locked(struct mbl_pvt *pvt)
+{
+	pvt->lecall_build_sequence = 0;
+	pvt->lecall_build_token = 0;
+	pvt->lecall_build_index = 0;
+	pvt->lecall_build_state = 0;
+	pvt->lecall_build_flags = 0;
+	pvt->lecall_build_has_call = 0;
+	pvt->lecall_build_ambiguous = 0;
+}
+
+/* The caller holds pvt->lock. Losing the GTBS control path tears down only
+ * the local Asterisk channel and LC3 descriptors. It deliberately sends no
+ * Accept or Terminate command to the phone. */
+static void mbl_lecall_set_ready_locked(struct mbl_pvt *pvt, int ready,
+	const char *reason)
+{
+	int was_ready = pvt->lecall_ready;
+	int had_owner = pvt->owner != NULL;
+
+	pvt->lecall_ready = ready != 0;
+	if (pvt->lecall_ready) {
+		if (!was_ready)
+			ast_log(LOG_NOTICE, "[%s] LE GTBS readiness=ready\n", pvt->id);
+		return;
+	}
+
+	pvt->lecall_pending_sequence = 0;
+	pvt->lecall_pending_opcode = 0;
+	pvt->lecall_snapshot_sequence = 0;
+	mbl_lecall_reset_build_locked(pvt);
+	if (pvt->lecall_token != 0)
+		pvt->lecall_suppressed_token = pvt->lecall_token;
+	pvt->lecall_token = 0;
+	pvt->lecall_index = 0;
+	pvt->lecall_state = CM_LE_CALL_NO_STATE;
+	pvt->lecall_flags = 0;
+	pvt->needchup = 0;
+	pvt->lecall_remote_ended = had_owner;
+	mbl_leaudio_stop_locked(pvt, had_owner ?
+		MBL_CALL_AUDIO_LE_FAILED : MBL_CALL_AUDIO_LE_PENDING);
+	if (had_owner)
+		mbl_queue_hangup(pvt);
+	if (was_ready || had_owner)
+		ast_log(LOG_WARNING,
+			"[%s] LE GTBS readiness=unavailable local_channel=%s reason=%s\n",
+			pvt->id, had_owner ? "released" : "none",
+			reason ? reason : "unspecified");
+}
+
+static void mbl_lecall_start_incoming_locked(struct mbl_pvt *pvt)
+{
+	struct ast_channel *channel;
+
+	if (pvt->owner || pvt->lecall_token == 0 ||
+		pvt->lecall_token == pvt->lecall_suppressed_token)
+		return;
+	pvt->incoming = 1;
+	pvt->outgoing = 0;
+	pvt->needchup = 0;
+	channel = mbl_new(AST_STATE_RING, pvt, NULL, NULL, NULL, NULL);
+	if (!channel) {
+		ast_log(LOG_ERROR,
+			"[%s] unable to allocate channel for GTBS incoming call\n",
+			pvt->id);
+		pvt->lecall_suppressed_token = pvt->lecall_token;
+		return;
+	}
+	ast_channel_exten_set(channel, "s");
+	if (ast_pbx_start(channel)) {
+		ast_log(LOG_ERROR,
+			"[%s] unable to start PBX for GTBS incoming call\n",
+			pvt->id);
+		pvt->lecall_suppressed_token = pvt->lecall_token;
+		mbl_queue_hangup(pvt);
+		return;
+	}
+	ast_log(LOG_NOTICE,
+		"[%s] routed one GTBS incoming call without caller URI exposure token=%" PRIu64 "\n",
+		pvt->id, pvt->lecall_token);
+}
+
+/* The caller holds pvt->lock and has received one complete snapshot. */
+static void mbl_lecall_commit_locked(struct mbl_pvt *pvt)
+{
+	uint64_t old_token = pvt->lecall_token;
+	uint64_t sequence = pvt->lecall_build_sequence;
+
+	if (pvt->lecall_build_ambiguous) {
+		ast_log(LOG_WARNING,
+			"[%s] multiple GTBS calls are present; refusing call and media correlation\n",
+			pvt->id);
+		pvt->lecall_token = 0;
+		pvt->lecall_index = 0;
+		pvt->lecall_state = CM_LE_CALL_NO_STATE;
+		pvt->lecall_flags = 0;
+		pvt->needchup = 0;
+		pvt->lecall_remote_ended = pvt->owner != NULL;
+		mbl_leaudio_stop_locked(pvt, pvt->owner ?
+			MBL_CALL_AUDIO_LE_FAILED : MBL_CALL_AUDIO_LE_PENDING);
+		if (pvt->owner)
+			mbl_queue_hangup(pvt);
+		pvt->lecall_snapshot_sequence = sequence;
+		mbl_lecall_reset_build_locked(pvt);
+		return;
+	}
+
+	if (!pvt->lecall_build_has_call) {
+		pvt->lecall_token = 0;
+		pvt->lecall_index = 0;
+		pvt->lecall_state = CM_LE_CALL_NO_STATE;
+		pvt->lecall_flags = 0;
+		pvt->lecall_suppressed_token = 0;
+		if (old_token != 0 || !pvt->owner)
+			mbl_leaudio_stop_locked(pvt, old_token != 0 ?
+				MBL_CALL_AUDIO_LE_FAILED : MBL_CALL_AUDIO_LE_PENDING);
+		if (old_token != 0) {
+			pvt->needchup = 0;
+			pvt->lecall_remote_ended = 1;
+			if (pvt->owner)
+				mbl_queue_hangup(pvt);
+		}
+		pvt->lecall_snapshot_sequence = sequence;
+		mbl_lecall_reset_build_locked(pvt);
+		return;
+	}
+
+	if (pvt->owner && old_token == 0 &&
+		!(pvt->lecall_build_flags & CM_LE_CALL_FLAG_OUTGOING)) {
+		ast_log(LOG_WARNING,
+			"[%s] an unrelated incoming GTBS call appeared while an outbound channel was reserved; failing closed\n",
+			pvt->id);
+		pvt->lecall_suppressed_token = pvt->lecall_build_token;
+		pvt->lecall_token = 0;
+		pvt->lecall_index = 0;
+		pvt->needchup = 0;
+		pvt->lecall_remote_ended = 1;
+		mbl_leaudio_stop_locked(pvt, MBL_CALL_AUDIO_LE_FAILED);
+		mbl_queue_hangup(pvt);
+		pvt->lecall_snapshot_sequence = sequence;
+		mbl_lecall_reset_build_locked(pvt);
+		return;
+	}
+
+	if (old_token != 0 && old_token != pvt->lecall_build_token &&
+		pvt->owner) {
+		ast_log(LOG_WARNING,
+			"[%s] GTBS call token changed while a channel was active; failing closed\n",
+			pvt->id);
+		pvt->lecall_suppressed_token = pvt->lecall_build_token;
+		pvt->lecall_token = 0;
+		pvt->lecall_index = 0;
+		pvt->needchup = 0;
+		pvt->lecall_remote_ended = 1;
+		mbl_leaudio_stop_locked(pvt, MBL_CALL_AUDIO_LE_FAILED);
+		mbl_queue_hangup(pvt);
+		pvt->lecall_snapshot_sequence = sequence;
+		mbl_lecall_reset_build_locked(pvt);
+		return;
+	}
+
+	pvt->lecall_token = pvt->lecall_build_token;
+	pvt->lecall_index = pvt->lecall_build_index;
+	pvt->lecall_state = pvt->lecall_build_state;
+	pvt->lecall_flags = pvt->lecall_build_flags;
+	pvt->lecall_snapshot_sequence = sequence;
+	pvt->lecall_remote_ended = 0;
+
+	if (!pvt->owner &&
+		pvt->lecall_state == CM_LE_CALL_STATE_INCOMING &&
+		!(pvt->lecall_flags & CM_LE_CALL_FLAG_OUTGOING)) {
+		mbl_lecall_start_incoming_locked(pvt);
+	} else if (pvt->owner) {
+		switch (pvt->lecall_state) {
+		case CM_LE_CALL_STATE_DIALING:
+			mbl_queue_control(pvt, AST_CONTROL_PROGRESS);
+			break;
+		case CM_LE_CALL_STATE_ALERTING:
+			mbl_queue_control(pvt, AST_CONTROL_RINGING);
+			break;
+		case CM_LE_CALL_STATE_ACTIVE:
+			if (!pvt->answered)
+				mbl_queue_control(pvt, AST_CONTROL_ANSWER);
+			pvt->answered = 1;
+			break;
+		default:
+			break;
+		}
+		if (pvt->call_audio_transport != MBL_CALL_AUDIO_LE &&
+			cm_leaudio_ready(&pvt->leaudio) &&
+			mbl_leaudio_activate_locked(pvt) < 0)
+			ast_log(LOG_WARNING,
+				"[%s] staged ISO pair could not be activated for the GTBS token\n",
+				pvt->id);
+	}
+	mbl_lecall_reset_build_locked(pvt);
+}
+
+static struct mbl_pvt *mbl_lecall_find_device(const char *device)
+{
+	struct mbl_pvt *pvt;
+
+	AST_RWLIST_TRAVERSE(&devices, pvt, entry) {
+		char address[18];
+
+		if (pvt->call_control != MBL_CALL_CONTROL_LE_GTBS)
+			continue;
+		ba2str(&pvt->addr, address);
+		if (cm_le_call_device_equal(device, address))
+			return pvt;
+	}
+	return NULL;
+}
+
+static void mbl_lecall_dispatch(const struct cm_le_call_message *message)
+{
+	struct mbl_pvt *pvt;
+
+	AST_RWLIST_RDLOCK(&devices);
+	pvt = mbl_lecall_find_device(message->device);
+	if (!pvt) {
+		AST_RWLIST_UNLOCK(&devices);
+		ast_log(LOG_WARNING,
+			"discarded GTBS packet for an unconfigured device\n");
+		return;
+	}
+	ast_mutex_lock(&pvt->lock);
+	switch (message->type) {
+	case CM_LE_CALL_READY:
+		mbl_lecall_set_ready_locked(pvt, message->code == 1,
+			message->code == 1 ? "phone GTBS ready" :
+			"phone GTBS unavailable");
+		break;
+	case CM_LE_CALL_STATE:
+		if (pvt->lecall_build_sequence != message->sequence) {
+			if ((pvt->lecall_build_sequence != 0 &&
+				 message->sequence < pvt->lecall_build_sequence) ||
+				(pvt->lecall_snapshot_sequence != 0 &&
+				 message->sequence <= pvt->lecall_snapshot_sequence)) {
+				ast_log(LOG_WARNING,
+					"[%s] discarded stale GTBS snapshot sequence=%" PRIu64 " last=%" PRIu64 "\n",
+					pvt->id, message->sequence,
+					pvt->lecall_snapshot_sequence);
+				break;
+			}
+			mbl_lecall_reset_build_locked(pvt);
+			pvt->lecall_build_sequence = message->sequence;
+		}
+		if (message->code == CM_LE_CALL_NO_STATE) {
+			if (pvt->lecall_build_has_call)
+				pvt->lecall_build_ambiguous = 1;
+		} else if (pvt->lecall_build_has_call) {
+			pvt->lecall_build_ambiguous = 1;
+		} else {
+			pvt->lecall_build_has_call = 1;
+			pvt->lecall_build_token = message->token;
+			pvt->lecall_build_index = message->index;
+			pvt->lecall_build_state = message->code;
+			pvt->lecall_build_flags = message->value;
+		}
+		if (message->flags & CM_LE_CALL_FLAG_LAST)
+			mbl_lecall_commit_locked(pvt);
+		break;
+	case CM_LE_CALL_ACK:
+		if (message->sequence == pvt->lecall_pending_sequence &&
+			message->code == pvt->lecall_pending_opcode &&
+			(message->code == CM_LE_CALL_ORIGINATE ||
+			 (message->token == pvt->lecall_token &&
+			  message->index == pvt->lecall_index))) {
+			pvt->lecall_pending_sequence = 0;
+			if (message->value != CM_LE_CALL_ACK_ACCEPTED) {
+				ast_log(LOG_WARNING,
+					"[%s] GTBS command opcode=%u rejected before phone result code=%u\n",
+					pvt->id, (unsigned int) message->code,
+					(unsigned int) message->value);
+				if (message->code == CM_LE_CALL_ACCEPT ||
+					message->code == CM_LE_CALL_ORIGINATE) {
+					pvt->lecall_local_answer_requested = 0;
+					pvt->needchup = 0;
+				}
+				if (pvt->owner &&
+					(message->code == CM_LE_CALL_ACCEPT ||
+					 message->code == CM_LE_CALL_ORIGINATE))
+					mbl_queue_hangup(pvt);
+			}
+		}
+		break;
+	case CM_LE_CALL_RESULT:
+		if (message->value != 0 && pvt->owner &&
+			(message->token == pvt->lecall_token ||
+			 message->code == CM_LE_CALL_ORIGINATE)) {
+			ast_log(LOG_WARNING,
+				"[%s] phone rejected GTBS opcode=%u result=%u\n",
+				pvt->id, (unsigned int) message->code,
+				(unsigned int) message->value);
+			if (message->code == CM_LE_CALL_ACCEPT ||
+				message->code == CM_LE_CALL_ORIGINATE) {
+				pvt->lecall_local_answer_requested = 0;
+				pvt->needchup = 0;
+			}
+			if (message->code == CM_LE_CALL_ACCEPT ||
+				message->code == CM_LE_CALL_ORIGINATE)
+				mbl_queue_hangup(pvt);
+		}
+		break;
+	default:
+		break;
+	}
+	ast_mutex_unlock(&pvt->lock);
+	AST_RWLIST_UNLOCK(&devices);
+}
+
+static void mbl_lecall_set_ready_all(int ready, const char *reason)
+{
+	struct mbl_pvt *pvt;
+
+	AST_RWLIST_RDLOCK(&devices);
+	AST_RWLIST_TRAVERSE(&devices, pvt, entry) {
+		if (pvt->call_control != MBL_CALL_CONTROL_LE_GTBS)
+			continue;
+		ast_mutex_lock(&pvt->lock);
+		mbl_lecall_set_ready_locked(pvt, ready, reason);
+		ast_mutex_unlock(&pvt->lock);
+	}
+	AST_RWLIST_UNLOCK(&devices);
+}
+
+static void mbl_lecall_disconnect(int *socket_fd)
+{
+	if (!socket_fd || *socket_fd < 0)
+		return;
+	ast_mutex_lock(&lecall_socket_mutex);
+	if (lecall_socket == *socket_fd)
+		lecall_socket = -1;
+	close(*socket_fd);
+	*socket_fd = -1;
+	ast_mutex_unlock(&lecall_socket_mutex);
+	mbl_lecall_set_ready_all(0, "call-control socket disconnected");
+}
+
+static void *do_lecall_control(void *data)
+{
+	int socket_fd = -1;
+
+	(void) data;
+	while (!check_unloading()) {
+		struct pollfd wait_fd;
+		int ready;
+
+		if (socket_fd < 0) {
+			socket_fd = cm_le_call_connect(lecall_socket_path);
+			if (socket_fd < 0) {
+				sleep(1);
+				continue;
+			}
+			ast_mutex_lock(&lecall_socket_mutex);
+			lecall_socket = socket_fd;
+			ast_mutex_unlock(&lecall_socket_mutex);
+			mbl_lecall_set_ready_all(0, "call-control socket connected");
+			ast_log(LOG_NOTICE,
+				"LE GTBS call-control socket connected\n");
+		}
+		memset(&wait_fd, 0, sizeof(wait_fd));
+		wait_fd.fd = socket_fd;
+		wait_fd.events = POLLIN;
+		ready = poll(&wait_fd, 1, 1000);
+		if (ready < 0) {
+			if (errno == EINTR)
+				continue;
+			mbl_lecall_disconnect(&socket_fd);
+			continue;
+		}
+		if (ready == 0)
+			continue;
+		if (wait_fd.revents & POLLIN) {
+			for (;;) {
+				struct cm_le_call_message message;
+				int result = cm_le_call_receive(socket_fd, &message);
+
+				if (result == -EAGAIN || result == -EWOULDBLOCK)
+					break;
+				if (result < 0) {
+					mbl_lecall_disconnect(&socket_fd);
+					break;
+				}
+				mbl_lecall_dispatch(&message);
+			}
+		}
+		if (socket_fd >= 0 &&
+			(wait_fd.revents & (POLLERR | POLLHUP | POLLNVAL)))
+			mbl_lecall_disconnect(&socket_fd);
+	}
+	mbl_lecall_disconnect(&socket_fd);
+	return NULL;
+}
